# HyperFrames local studio/snapshot state
.hyperframes/
node_modules/

# fuck: assets que genera tools/prepare.py (logos de terceros, fotos del propietario, portadas).
/content/videos/fuck/project/assets/

# Pipeline: renders de arranques y piezas (no se versionan).
/pipeline/4-produccion/arranque/out/

